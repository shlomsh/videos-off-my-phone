{
  "manifest_version": 3,
  "name": "Videos Off My Phone",
  "version": "0.13.0",
  "description": "Free and open source. Move big videos to your own YouTube channel, which doesn't use your Google storage, then delete the originals.",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Videos Off My Phone",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "https://www.youtube.com/*"
  ],
  "host_permissions": [
    "https://photos.google.com/*",
    "https://video-downloads.googleusercontent.com/*",
    "https://*.googlevideo.com/*",
    "https://www.googleapis.com/youtube/v3/*",
    "https://www.googleapis.com/upload/youtube/v3/*"
  ]
}
