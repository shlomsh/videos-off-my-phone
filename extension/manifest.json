{
  "manifest_version": 3,
  "name": "Video Offload (proof of concept)",
  "version": "0.8.2",
  "description": "Moves original videos from Google Photos to YouTube as private, without saving them to disk. Deletes only a video you confirm, by moving it to the Google Photos trash.",
  "key": "",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Video Offload"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "https://www.youtube.com/*"
  ],
  "host_permissions": [
    "https://photos.google.com/*",
    "https://video-downloads.googleusercontent.com/*",
    "https://*.googlevideo.com/*",
    "https://www.googleapis.com/*"
  ]
}
